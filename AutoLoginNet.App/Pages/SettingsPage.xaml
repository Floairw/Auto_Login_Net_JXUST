<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoLoginNet.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:ui="using:AutoLoginNet.App.UiSupport"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ui:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ui:StatusSeverityConverter x:Key="SeverityConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,24,32,32" MaxWidth="1080" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
                <TextBlock Text="设置" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock
                    Text="外观、认证服务器与数据位置（开机自启已移至首页）"
                    Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <InfoBar
                Grid.Row="1"
                Margin="0,0,0,14"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
                IsClosable="True"
                Severity="{x:Bind ViewModel.StatusIsError, Mode=OneWay, Converter={StaticResource SeverityConverter}}"
                Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <Grid Grid.Row="2" ColumnSpacing="16" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 外观（开机自启已移至首页，此处独占整行） -->
                <Border Grid.Column="0" Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="外观" Style="{StaticResource SectionTitleTextStyle}" />

                        <StackPanel>
                            <TextBlock Text="主题" Style="{StaticResource FieldLabelTextStyle}" />
                            <ComboBox
                                x:Name="ThemeCombo"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="ThemeCombo_SelectionChanged">
                                <ComboBoxItem Content="跟随系统" />
                                <ComboBoxItem Content="浅色" />
                                <ComboBoxItem Content="深色" />
                            </ComboBox>
                        </StackPanel>

                        <CheckBox
                            Content="启动时自动检测网络环境"
                            IsChecked="{x:Bind ViewModel.AutoDetectOnStartup, Mode=TwoWay}" />
                        <CheckBox
                            Content="关闭主窗口时最小化到系统托盘"
                            IsChecked="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}"
                            ToolTipService.ToolTip="勾选后点关闭按钮不会退出程序；退出请用托盘菜单的「退出程序」" />
                        <CheckBox
                            Content="登录成功时记住账号密码"
                            IsChecked="{x:Bind ViewModel.RememberCredential, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

            </Grid>

            <!-- 认证服务器 -->
            <Border Grid.Row="3" Style="{StaticResource AppCardStyle}" Margin="0,0,0,16">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="认证服务器" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Text="默认值适用于江西理工大学 Dr.COM ePortal。仅在网络中心调整了服务地址时才需要修改。"
                            Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="服务器地址" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{x:Bind ViewModel.AuthHost, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="端口" Style="{StaticResource FieldLabelTextStyle}" />
                            <NumberBox
                                Value="{x:Bind ViewModel.AuthPort, Mode=TwoWay}"
                                Minimum="1"
                                Maximum="65535"
                                SpinButtonPlacementMode="Compact" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="登录接口路径" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{x:Bind ViewModel.LoginPath, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="HTTP 超时（秒）" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{x:Bind ViewModel.HttpTimeoutSeconds, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            Content="保存设置"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Save_Click" />
                        <TextBlock
                            Text="修改服务器地址后需保存；主题为即时生效。"
                            Style="{StaticResource CaptionTextStyle}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 工具与数据 -->
            <Grid Grid.Row="4" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="工具" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                Text="校园内网测速页因校而异，默认留空，需要时自行填写。"
                                Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="校园内网测速页" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox
                                PlaceholderText="例如 http://speedtest.example.edu.cn"
                                Text="{x:Bind ViewModel.CampusSpeedTestUrl, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="外网测速页" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{x:Bind ViewModel.InternetSpeedTestUrl, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="数据与关于" Style="{StaticResource SectionTitleTextStyle}" />

                        <TextBlock Text="{x:Bind ViewModel.VersionText}" FontWeight="SemiBold" />
                        <TextBlock
                            Text="{x:Bind ViewModel.ConfigFilePath}"
                            Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.LogFilePath}"
                            Style="{StaticResource CaptionTextStyle}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="打开数据目录" Click="OpenDataFolder_Click" />
                            <Button Content="打开配置文件" Click="OpenConfigFile_Click" />
                            <Button Content="恢复默认配置" Click="Reset_Click" />
                        </StackPanel>

                        <TextBlock
                            Text="密码使用 Windows DPAPI（当前用户 + 附加熵）加密存储，文件被复制到其他机器或用户下均无法解密。"
                            Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
