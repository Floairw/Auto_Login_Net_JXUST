<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoLoginNet.App.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:diag="using:AutoLoginNet.Diagnostics"
    xmlns:ui="using:AutoLoginNet.App.UiSupport"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    DataContext="{x:Bind ViewModel}">

    <Page.Resources>
        <ui:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ui:BooleanToVisibilityConverter x:Key="BoolToVisInverted" Invert="True" />
        <ui:TimestampConverter x:Key="TimestampConverter" />
    </Page.Resources>

    <Grid Margin="32,24,32,24" MaxWidth="1180" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="运行日志" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock
                Text="实时查看运行记录。所有密码类字段在写入前已被脱敏为 ***。"
                Style="{StaticResource PageSubtitleTextStyle}" />
        </StackPanel>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Style="{StaticResource AppCardStyle}" Padding="16" Margin="0,0,0,12">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        PlaceholderText="按关键字过滤（消息或分类）"
                        Text="{x:Bind ViewModel.Filter.Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ComboBox
                        x:Name="LevelCombo"
                        Grid.Column="1"
                        MinWidth="140"
                        SelectionChanged="LevelCombo_SelectionChanged" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="刷新" Click="Refresh_Click" />
                        <Button Content="清空" Click="Clear_Click" />
                        <Button Content="打开日志目录" Click="OpenFolder_Click" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox
                        Content="自动滚动到最新"
                        IsChecked="{x:Bind ViewModel.AutoScroll, Mode=TwoWay}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                        Style="{StaticResource CaptionTextStyle}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 日志列表 -->
        <Border Grid.Row="2" Style="{StaticResource AppCardStyle}" Padding="8">
            <Grid>
                <ScrollViewer
                    x:Name="LogScrollViewer"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled"
                    HorizontalScrollMode="Disabled"
                    ViewChanged="LogScrollViewer_ViewChanged">
                    <ListView
                        x:Name="LogList"
                        ItemsSource="{Binding Entries}"
                        SelectionMode="Extended"
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="diag:LogEntry">
                            <Grid ColumnSpacing="10" Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="{x:Bind Timestamp, Converter={StaticResource TimestampConverter}}"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Top" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind Level}"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    MinWidth="60"
                                    VerticalAlignment="Top" />

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind Category}"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MinWidth="64"
                                    VerticalAlignment="Top" />

                                <TextBlock
                                    Grid.Column="3"
                                    Text="{x:Bind Message}"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True"
                                    VerticalAlignment="Top" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>

                <StackPanel
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="6"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <FontIcon Glyph="&#xE9D9;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="暂无日志记录" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
